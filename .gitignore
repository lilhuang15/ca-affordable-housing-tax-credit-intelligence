# --- Data files (too large for git, users re-download from source) ---
data/Raw/
data/raw/
data/External/
data/processed/
data/*.xlsx
data/*.csv
data/*.doc
data/lihtcpub/

# --- Model artifacts (regenerated by running notebooks) ---
models/*.pkl
models/*.joblib
models/*.npy
models/*.parquet

# --- API keys and secrets ---
.env
*.env

# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*_executed.ipynb

# --- macOS ---
.DS_Store
**/.DS_Store

# --- IDE ---
.vscode/
.idea/

# --- Temp files ---
~$*

# --- Claude Code internal memory (local only) ---
.claude/

# --- Streamlit cache ---
.streamlit/

# --- Word / Office lock files ---
~$*.docx
~$*.xlsx
